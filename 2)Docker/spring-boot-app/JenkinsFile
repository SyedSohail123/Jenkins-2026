pipeline {
    agent {
        docker {
            image 'maven:3.8.8-eclipse-temurin-11'
            label 'Worker-1'
            args '-v /home/jenkins/.m2:/root/.m2'
        }
    }

    stages {
        stage('Build & Package') {
            steps {
                echo 'Building Java 11 application...'
                // Generates the artifact inside the target/ directory
                sh 'mvn clean package -DskipTests'
            }
        }
    }

    post {
        success {
            echo 'Archiving the built artifact...'
            // Keeps the target file available to download from the Jenkins UI
            archiveArtifacts artifacts: 'target/*.**', fingerprint: true
        }
        always {
            cleanWs()
        }
    }
}

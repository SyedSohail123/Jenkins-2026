pipeline {
    agent {
        docker {
            image 'maven:3.8.8-eclipse-temurin-11'
            label 'Worker-1'
            args '-v /home/jenkins/.m2:/root/.m2'
        }
    }

    stages {
        stage('Build & Package') {
            steps {
                echo 'Building Java 11 application...'
                // Using single quotes tells the shell to treat the parenthesis as a literal string
                dir("2)Docker/spring-boot-app") {
                    sh 'mvn clean package'
                }
            }
            // Archiving directly inside the stage ensures it happens immediately after compilation
            post {
                success {
                    echo 'Archiving built artifacts...'
                    // Uses a broad wildcard to catch any file format inside the target directory
                    archiveArtifacts artifacts: '**/target/*', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
